# AI-assisted
# Space-App-X86 Full-Mode Server Configuration Example
# Copy this file to `.env` and set your own values. Never commit `.env` or real secrets.

# Bind address and port for the Axum HTTP server (supports BIND_ADDR or SERVER_ADDR)
BIND_ADDR=0.0.0.0:8080
SERVER_ADDR=0.0.0.0:8080

# Directories for processed GIS/3D assets and compiled Trunk WASM frontend
DATA_DIR=data/processed
WEIGHTS_FILE=pipeline/weights.json
STATIC_DIR=dist

# Researcher authentication credentials (Argon2id)
# Generate an Argon2id PHC hash on the server using:
#   cargo run -p analog_server -- --hash-password "<your-password>"
# Wrap the PHC string in single quotes in `.env` so `$argon2id$...` is not expanded by shells.
RESEARCHER_USERNAME=equipo_analog
RESEARCHER_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$REPLACE_WITH_SALT$REPLACE_WITH_HASH'

# Secret key used to sign HttpOnly researcher session cookies (optional; ephemeral key generated if empty)
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false

# Login rate limiting per client IP
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
